#!/usr/bin/env bash
# ws <name>: open a Ghostty window from ghostty/workspaces/<name>.
# One tab per line, split left/right: command on the left, shell on the right.
# Uses Ghostty's AppleScript dictionary (1.3+). Tab colours aren't scriptable yet.
set -e

DIR="$(cd "$(dirname "$(readlink "$0" || echo "$0")")/.." && pwd)/ghostty/workspaces"
NAME="$1"

if [ -z "$NAME" ] || [ ! -f "$DIR/$NAME" ]; then
  echo "usage: ws <name>   (available: $(ls "$DIR" | tr '\n' ' '))" >&2
  exit 1
fi

trim() { printf '%s' "$1" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//'; }

WIN=""
grep -v '^[[:space:]]*\(#\|$\)' "$DIR/$NAME" | while IFS='|' read -r title dir cmd; do
  title=$(trim "$title")
  dir=$(trim "$dir"); dir="${dir/#\~/$HOME}"
  cmd=$(trim "$cmd"); [ -n "$cmd" ] || cmd="cl --continue"
  [ -d "$dir" ] || { echo "skip $title: $dir not found" >&2; continue; }

  WIN=$(osascript - "$title" "$dir" "$cmd" "$WIN" <<'APPLESCRIPT'
on run argv
  set {tabTitle, tabDir, tabCmd, winId} to argv
  tell application "Ghostty"
    set leftCfg to {initial working directory:tabDir, initial input:tabCmd & linefeed}
    if winId is "" then
      set w to new window with configuration leftCfg
      set t to selected tab of w
    else
      set w to window id winId
      set t to new tab in w with configuration leftCfg
    end if
    set leftPane to focused terminal of t
    perform action ("set_tab_title:" & tabTitle) on leftPane
    split leftPane direction right with configuration {initial working directory:tabDir}
    focus leftPane
    return id of w
  end tell
end run
APPLESCRIPT
)
  echo "opened $title"
done
